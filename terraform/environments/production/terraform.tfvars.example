# Copy to terraform.tfvars (gitignored) and fill in real values.

aws_region  = "ap-south-1" # must match your worldmonitor Secrets Manager secret's region
azs         = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]
admin_cidrs = ["203.0.113.4/32"] # your IP, /32

key_name = "your-existing-ec2-key-pair-name"

# Manually requested in ACM (DNS-validated) for the dashboard's ALB — must be
# in aws_region above.
acm_certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# After applying: aws eks update-kubeconfig --name <eks_cluster_name output> --region ap-south-1
# then run `flux bootstrap github` once by hand — see the plan/session notes
# for the exact command. Flux picks up cluster_autoscaler_role_arn,
# external_secrets_role_arn, aws_load_balancer_controller_role_arn, vpc_id,
# and acm_certificate_arn automatically via the flux-system/terraform-outputs
# ConfigMap — no manual copy-in needed.
